<!DOCTYPE html>
<html>
<head>
    <title>Love Letter 💌</title>
    <style>
        body {
            background: #ffe6f2;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Courier New', cursive;
        }

        .envelope {
            position: relative;
            cursor: pointer;
            transition: all 0.5s;
        }

        .card {
            background: linear-gradient(45deg, #ffb3d9, #ff99cc);
            width: 300px;
            height: 400px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(255, 153, 204, 0.5);
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.8s;
        }

        .card.flipped {
            transform: rotateY(180deg);
        }

        .front, .back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .back {
            transform: rotateY(180deg);
            color: white;
        }

        .heart {
            color: #ff4d88;
            font-size: 60px;
            animation: pulse 1.5s infinite;
        }

        .love-text {
            text-align: center;
            font-size: 18px;
            line-height: 1.6;
            margin: 20px;
        }

        .signature {
            font-style: italic;
            margin-top: 20px;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .hearts-animation {
            position: fixed;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .heart-emoji {
            position: absolute;
            animation: float 3s linear infinite;
            opacity: 0;
        }

        @keyframes float {
            0% { transform: translateY(100vh) scale(0); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translateY(-100vh) scale(1.5); opacity: 0; }
        }
    </style>
</head>
<body>
    <div class="hearts-animation" id="hearts"></div>
    
    <div class="envelope" onclick="toggleCard()">
        <div class="card" id="card">
            <div class="front">
                <div class="heart">💌</div>
                <h2>Click to Open</h2>
            </div>
            <div class="back">
                <div class="love-text">
                    Good job for these days, sayangku, cintaku, cantikku,<br><br>
                    Thanks for run to me when the world gets mean to you, talk to me when everything is overwhelming, you'll always have me right next to you.<br>
                    Yeah, you may not believe in luckiness, but how lucky I am to exist on the same time as you, to find you in every familiar place.<br>
                    So, there will be a million places I could be, but none of them feel right without you,<br>
                    you're not just my person, you're the place my heart calls home.<br><br>
                    Forever yours,
                    <div class="signature">💖 Your Beloved</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleCard() {
            document.getElementById('card').classList.toggle('flipped');
        }

        // Create floating hearts
        function createHearts() {
            const heartsContainer = document.getElementById('hearts');
            const emojis = ['❤️', '💖', '💕', '💗', '💓'];
            
            for (let i = 0; i < 50; i++) {
                const heart = document.createElement('div');
                heart.className = 'heart-emoji';
                heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.animationDelay = Math.random() * 2 + 's';
                heartsContainer.appendChild(heart);
            }
        }

        createHearts();
    </script>
</body>
</html>
